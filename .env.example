NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nouraschool
JWT_SECRET=change-me-in-production
FRONTEND_RESET_URL=http://localhost:4200/reset-password
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
S3_ENDPOINT=https://minio.example.com
S3_ACCESS_KEY=minio-access-key
S3_SECRET_KEY=minio-secret-key
S3_BUCKET=noura-school
S3_PUBLIC_URL=https://minio.example.com
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
REDIS_URL=redis://default:password@localhost:6379/0
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,https://noura-school.assanediallo.com,https://nouraschool.assanediallo.com

# Compte Super Admin du backoffice SaaS plateforme.
# Le script scripts/seed-platform-super-admin.cjs est idempotent.
PLATFORM_SUPER_ADMIN_EMAIL=superadmin@nouraschool.local
PLATFORM_SUPER_ADMIN_PASSWORD=Noura@2026!
PLATFORM_SUPER_ADMIN_PRENOM=Super Admin
PLATFORM_SUPER_ADMIN_NOM=NouraSchool
PLATFORM_SUPER_ADMIN_TELEPHONE=
# Mettre true uniquement si vous voulez forcer la reinitialisation du mot de passe au prochain deploiement.
PLATFORM_SUPER_ADMIN_RESET_PASSWORD=false

# Mot de passe temporaire utilise pour l'admin initial d'une ecole creee depuis la plateforme
# si aucun canal email/WhatsApp n'est actif.
TENANT_INITIAL_ADMIN_PASSWORD=

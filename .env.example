NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edusen
JWT_SECRET=change-me-in-production
FRONTEND_RESET_URL=https://medaaris.com/reset-password
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
S3_ENDPOINT=https://minio.example.com
S3_ACCESS_KEY=minio-access-key
S3_SECRET_KEY=minio-secret-key
S3_BUCKET=noura-school
S3_PUBLIC_URL=https://minio.example.com
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
REDIS_URL=redis://default:password@localhost:6379/0
DATABASE_CONNECTION_LIMIT=8
DATABASE_POOL_TIMEOUT_SECONDS=10
PRISMA_READ_RETRY_ATTEMPTS=2
PRISMA_READ_RETRY_DELAY_MS=150
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,https://medaaris.com,https://sablettes.medaaris.com,https://noukhbetelasr.medaaris.com,https://noura.medaaris.com,https://zeinelabidine.medaaris.com
CORS_ALLOWED_DOMAIN_SUFFIXES=.medaaris.com
API_PUBLIC_URL=https://backend.medaaris.com/api

# Protection et capacite HTTP SaaS. Les valeurs peuvent etre ajustees dans Coolify.
HTTP_BODY_LIMIT_BYTES=5242880
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
HTTP_RATE_LIMIT_MAX=240
HTTP_RATE_LIMIT_WINDOW=1 minute
HTTP_COMPRESSION_THRESHOLD_BYTES=1024
SLOW_REQUEST_MS=750
AUTH_PASSWORD_COMPARE_CONCURRENCY=4
AUTH_LOGIN_CANDIDATE_CONCURRENCY=2
AUTH_LOGIN_MAX_CANDIDATES=12

# WhatsApp est couteux (Chromium + archives de session). Augmenter prudemment selon la RAM.
WHATSAPP_BACKUP_SYNC_INTERVAL_MS=900000
WHATSAPP_SESSION_SAVE_CONCURRENCY=1
# "s3" libere Redis des archives RemoteAuth volumineuses ; "redis" reste possible en local.
WHATSAPP_SESSION_STORAGE=s3
# En production multi-replica : false pour les APIs, true sur un seul worker WhatsApp dedie.
WHATSAPP_CLIENT_ENABLED=true

# Provider WhatsApp externe. En mode relayio, ce backend consomme l API Relayio
# au lieu de lancer whatsapp-web.js/Chromium localement.
# Valeurs: local | relayio
WHATSAPP_PROVIDER=local
RELAYIO_BASE_URL=https://relayio-backend.medaaris.com
# Garder cette cle uniquement cote serveur: rtest_ pour sandbox, rdev_/rlive_ pour envoi reel.
RELAYIO_API_KEY=
# Optionnel: si une session Relayio existe deja, force son utilisation.
RELAYIO_SESSION_ID=
# Optionnel: numero utilise pour creer la session ou demander un pairing code.
RELAYIO_PHONE_NUMBER=
RELAYIO_SESSION_AUTH_TYPE=local
RELAYIO_QR_POLL_ATTEMPTS=10
RELAYIO_QR_POLL_INTERVAL_MS=1000
RELAYIO_TIMEOUT_MS=15000

# Compte Super Admin du backoffice SaaS plateforme.
# Le script scripts/seed-platform-super-admin.cjs est idempotent.
PLATFORM_SUPER_ADMIN_EMAIL=superadmin@edusen.local
PLATFORM_SUPER_ADMIN_PASSWORD=Edusen@2026!
PLATFORM_SUPER_ADMIN_PRENOM=Super Admin
PLATFORM_SUPER_ADMIN_NOM=Edusen
PLATFORM_SUPER_ADMIN_TELEPHONE=
# Mettre true uniquement si vous voulez forcer la reinitialisation du mot de passe au prochain deploiement.
PLATFORM_SUPER_ADMIN_RESET_PASSWORD=false

# Mot de passe temporaire utilise pour l'admin initial d'une ecole creee depuis la plateforme
# si aucun canal email/WhatsApp n'est actif.
TENANT_INITIAL_ADMIN_PASSWORD=

{
  "name": "nouraschool-backend-nestjs",
  "version": "1.0.0",
  "private": true,
  "description": "Migration complete Noura School backend vers NestJS",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:perf": "jest --runInBand test/performance",
    "setup:seed": "npx prisma generate && npx prisma db push && npm run seed",
    "seed": "node scripts/seed.cjs",
    "seed:platform": "node scripts/seed-platform-super-admin.cjs",
    "db:clear": "node scripts/clear-db.cjs",
    "db:backup-transfer": "bash scripts/postgres-backup-transfer.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node scripts/seed.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",

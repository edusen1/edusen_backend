// ==================== CALENDAR ====================

enum TypeEvenementCalendrier {
  // Periodes
  RENTREE
  FIN_ANNEE
  DEBUT_TRIMESTRE
  FIN_TRIMESTRE
  REPRISE_COURS
  // Vacances
  VACANCES
  JOUR_FERIE
  PONT
  // Evaluations
  DEVOIR_SURVEILLE
  COMPOSITION
  EXAMEN_BLANC
  EXAMEN_OFFICIEL
  RATTRAPAGE
  REMISE_COPIES
  // Reunions
  CONSEIL_CLASSE
  CONSEIL_DISCIPLINE
  REUNION_PARENTS
  REUNION_PEDAGOGIQUE
  ASSEMBLEE_GENERALE
  // Vie scolaire
  JOURNEE_PORTES_OUVERTES
  JOURNEE_CULTURELLE
  JOURNEE_SPORTIVE
  REMISE_PRIX
  SORTIE_PEDAGOGIQUE
  SEMAINE_REVISION
  PUBLICATION_BULLETINS
  DISTRIBUTION_CARTES
  // Administratif
  DATE_LIMITE_INSCRIPTION
  DATE_LIMITE_PAIEMENT
  FORMATION_ENSEIGNANTS
  AUTRE
}

enum StatutEvenement {
  PLANIFIE
  CONFIRME
  ANNULE
  REPORTE
}

enum VisibiliteEvenement {
  TOUS
  ADMIN
  ENSEIGNANTS
  PARENTS
  ELEVES
  SURVEILLANTS
  CAISSE
  RH
}

model CalendrierScolaire {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @db.Uuid
  tenant      Tenant                    @relation(fields: [tenantId], references: [id])
  sectionId   String?                   @db.Uuid
  section     Cycle?                    @relation(fields: [sectionId], references: [id])
  titre       String
  description String?
  dateDebut   DateTime                  @db.Date
  dateFin     DateTime?                 @db.Date
  heureDebut  String?                   @db.VarChar(5)
  heureFin    String?                   @db.VarChar(5)
  type        TypeEvenementCalendrier   @default(AUTRE)
  statut      StatutEvenement           @default(PLANIFIE)
  visibilites VisibiliteEvenement[]     @default([TOUS])
  classeId    String?                   @db.Uuid
  niveauId    String?                   @db.Uuid
  couleur     String?                   @db.VarChar(7)
  important   Boolean                   @default(false)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([tenantId, sectionId, dateDebut])
  @@index([tenantId, type])
}

// ==================== AUDIT ====================

model AuditLog {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String?                @db.Uuid
  tenant           Tenant?                @relation(fields: [tenantId], references: [id])
  utilisateurId    String?                @db.Uuid
  utilisateur      User?                  @relation(fields: [utilisateurId], references: [id])
  plateformeUserId String?                @db.Uuid
  plateformeUser   PlateformeUtilisateur? @relation(fields: [plateformeUserId], references: [id])
  role             String?                @db.VarChar(50)
  action           String                 @db.VarChar(100)
  resourceType     String?                @db.VarChar(100)
  resourceId       String?                @db.Uuid
  details          Json?
  ipAddress        String?                @db.VarChar(45)
  userAgent        String?

  // Enriched user info (denormalized for historical traceability)
  userMatricule    String?                @db.VarChar(50)
  userNomComplet   String?                @db.VarChar(200)
  userEmail        String?                @db.VarChar(200)
  userTelephone    String?                @db.VarChar(30)
  userUsername      String?                @db.VarChar(100)

  // Device info (parsed from userAgent)
  deviceType       String?                @db.VarChar(50)
  browserName      String?                @db.VarChar(100)
  osName           String?                @db.VarChar(100)

  // Geolocation (from IP)
  geoCity          String?                @db.VarChar(100)
  geoCountry       String?                @db.VarChar(100)

  createdAt        DateTime               @default(now())

  @@index([tenantId, createdAt])
  @@index([utilisateurId])
}

enum StatutDemandeAudit {
  EN_ATTENTE
  APPROUVEE
  REJETEE
}

model DemandeAudit {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  demandePar      String              @db.Uuid
  demandeur       User                @relation("demandeAuditDemandeur", fields: [demandePar], references: [id])
  motif           String
  dateDebut       DateTime            @db.Date
  dateFin         DateTime            @db.Date
  // Filtres de la demande (ce que l'admin veut auditer)
  filtreActions   String[]            @default([])   // ex: ["CREATION","SUPPRESSION","MODIFICATION"]
  filtreRoles     String[]            @default([])   // ex: ["ENSEIGNANT","CAISSIER"]
  filtreUserId    String?             @db.Uuid       // user specifique
  filtreResources String[]            @default([])   // ex: ["paiement","inscription","bulletin"]
  statut          StatutDemandeAudit  @default(EN_ATTENTE)
  traitePar       String?             @db.Uuid
  commentaire     String?
  dateTraitement  DateTime?
  expirationAcces DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([tenantId, statut])
}

// ==================== AUTH TOKENS ====================

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid

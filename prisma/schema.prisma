generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  GESTIONNAIRE
  ADMIN
  CAISSIER
  COMPTABLE
  SURVEILLANT
  SECURITE
  ENSEIGNANT
  ELEVE
  PARENT
  RH
}

enum RolePlateforme {
  SUPER_ADMIN
  GESTIONNAIRE
}

enum Genre {
  M
  F
  AUTRE
}

enum LienParente {
  PERE
  MERE
  TUTEUR
  TUTRICE
  ONCLE
  TANTE
  GRAND_PERE
  GRAND_MERE
  AUTRE
}

enum TypeEvaluation {
  DEVOIR
  INTERROGATION
  EXAMEN
  COMPOSITION
  CONTROLE
  TP
  ORAL
  BONUS
}

enum StatutPaiement {
  EN_ATTENTE
  VALIDE
  REJETE
}

enum TypePaiement {
  SCOLARITE
  INSCRIPTION
  CANTINE
  TRANSPORT
  AUTRE
}

enum ModePaiement {
  ESPECES
  VIREMENT
  CHEQUE
  MOBILE_MONEY
  CARTE
}

enum TypeAbsence {
  ABSENT
  RETARD
}

enum StatutAbsenceEleve {
  EN_ATTENTE
  JUSTIFIEE
  NON_JUSTIFIEE
}

enum StatutBulletin {
  BROUILLON
  SOUMIS
  VALIDE
  PUBLIE
}

enum StatutDemande {
  EN_ATTENTE
  APPROUVEE
  REJETEE
}

enum TypeDocument {
  EXTRAIT_NAISSANCE
  PHOTO_CNI
  VISITE_MEDICALE
  CARNET_SANTE
  VACCINATION
  DIPLOME
  PHOTO
  AUTRE
}

enum StatutInscription {
  ACTIF
  INACTIF
  TRANSFERE
  EXCLU
  TERMINE
}

enum StatutAppel {
  BROUILLON
  SOUMIS
  VALIDE
}

enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
}

enum TypePointage {
  ENTREE
  SORTIE
}

enum TypeContrat {
  CDI
  CDD
  STAGE
  VACATAIRE
  BENEVOLE
}

enum TypeAbsencePersonnel {
  MALADIE
  CONGE
  SANS_SOLDE
  AUTRE
}

enum StatutAbsencePersonnel {
  EN_ATTENTE
  APPROUVEE
  REJETEE
}

enum StatutReclamation {
  EN_ATTENTE
  TRAITEE
  REJETEE
}

enum StatutDemandePassage {
  EN_ATTENTE
  APPROUVEE
  REJETEE
}

enum CanalNotification {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum StatutNotification {
  EN_ATTENTE
  ENVOYE
  ECHEC
}

enum TypeSanction {
  AVERTISSEMENT
  BLAME
  RETENUE
  EXCLUSION_COURS
  EXCLUSION_TEMPORAIRE
  EXCLUSION_DEFINITIVE
  TRAVAUX_INTERET_SCOLAIRE
  CONSEIL_DISCIPLINE
}

enum StatutDiscipline {
  OUVERT
  EN_TRAITEMENT
  CLOTURE
  APPEL
  ANNULE
}

enum RoleRapporteur {
  ADMIN
  ENSEIGNANT
  PROFESSEUR
  SURVEILLANT
  ELEVE
  PERSONNEL
  PARENT
}

// ==================== TENANT ====================

model Tenant {
  id             String    @id @default(uuid()) @db.Uuid
  slug                String    @unique @db.VarChar(100)
  codeAccesEleve      String    @unique @db.VarChar(16)
  codeAccesEnseignant String    @unique @db.VarChar(16)
  codeAccesCaissier   String    @unique @db.VarChar(16)
  codeAccesAdmin      String    @unique @db.VarChar(16)
  codeAccesSurveillant String   @unique @db.VarChar(16)
  codeAccesRh         String    @unique @db.VarChar(16)
  nom            String
  emailContact   String?   @db.VarChar(254)
  telephone      String?   @db.VarChar(20)
  adresse        String?
  logoUrl        String?
  plan           String    @default("TRIAL") @db.VarChar(50)
  actif          Boolean   @default(true)
  dateExpiration DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  ecoleConfig         EcoleConfig?
  fraisNiveaux        FraisNiveauConfig[]
  whatsappSession     WhatsappSession?
  whatsappOutbox      WhatsappOutbox[]
  users               User[]
  cycles              Cycle[]
  niveaux             Niveau[]
  batiments           Batiment[]
  salles              Salle[]
  annees              AnneeAcademique[]
  classes             Classe[]
  matieres            Matiere[]
  professeurMatieres  ProfesseurMatiere[]
  matiereClasses      MatiereClasse[]
  cours               Cours[]
  inscriptions        Inscription[]
  paiements           Paiement[]
  paiementsProfesseurs PaiementProfesseur[]
  absencesEleves      AbsenceEleve[]
  absencesEnseignants AbsenceEnseignant[]
  emploisDuTemps      EmploiDuTemps[]
  notes               Note[]
  bulletins           Bulletin[]
  reclamations        Reclamation[]
  appels              Appel[]
  cahiersTexte        CahierTexte[]
  annonces            Annonce[]
  communications      Communication[]
  convocations        Convocation[]
  liensBulletin       LienBulletinParent[]
  liensPaiement       LienPaiementParent[]
  demandesPassage     DemandePassage[]
  disciplines         Discipline[]
  personnels          Personnel[]
  personnelNiveauAffectations PersonnelNiveauAffectation[]
  pointages           Pointage[]
  presencesCoursProfesseurs PresenceCoursProfesseur[]
  absencesPersonnel   AbsencePersonnel[]
  notifications       Notification[]
  pushTokens          PushToken[]
  notificationLogs    NotificationLog[]
  auditLogs           AuditLog[]
  calendrier          CalendrierScolaire[]
  surveillantCycles   SurveillantCycle[]
  classeStagiaires    ClasseStagiaire[]
  ecolePalettes       EcolePaletteConfig[]
  matiereNiveaux      MatiereNiveau[]
  demandesReduction   DemandeReduction[]
  eleveDocuments      EleveDocument[]
  demandesAudit       DemandeAudit[]
  programmes          ProgrammePedagogique[]
  featureOverrides    TenantFeatureOverride[]
  ouvrages            Ouvrage[]
  empruntsOuvrage     EmpruntOuvrage[]
  documentTemplates   DocumentTemplate[]
}

// ==================== FRAIS NIVEAU CONFIG ====================

model FraisNiveauConfig {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section     String   @db.VarChar(100)
  niveau      String   @db.VarChar(100)
  inscription Float    @default(0)
  mensualite  Float    @default(0)
  nbMois      Int      @default(9)
  moisDebut   Int?
  moisFin     Int?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, section, niveau])
  @@index([tenantId])
}

// ==================== ECOLE CONFIG ====================

model EcoleConfig {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @unique @db.Uuid
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nom               String   @db.VarChar(200)
  slogan            String?  @db.VarChar(300)
  adresse           String   @db.VarChar(300)
  ville             String   @db.VarChar(100)
  pays              String   @default("SN") @db.VarChar(5)
  telephone         String   @db.VarChar(25)
  email             String   @db.VarChar(254)
  siteWeb           String?  @db.VarChar(500)
  numeroAgrement    String?  @db.VarChar(100)
  typeEtablissement String   @default("PRIVE") @db.VarChar(20)
  logoUrl           String?
  logoS3Key         String?
  cachetUrl         String?
  cachetS3Key       String?
  montantHoraireDefaut Float?
  /**
   * Grille horaire par cycle, propre à chaque école.
   * Forme : { "PRIMAIRE": { joursAvecApresMidi, joursMatinSeul, matinDebut,
   * matinFin, apresMidiDebut, apresMidiFin, recreationDebut, recreationMinutes } }
   * Stockée en JSON plutôt qu'en table dédiée : une école n'a qu'une poignée de
   * cycles et la grille est lue d'un bloc à chaque affichage d'emploi du temps.
   */
  grilleHoraire     Json?
  /**
   * Tarifs de la bibliothèque : caution d'emprunt, pénalité de retard par jour,
   * durée d'emprunt par défaut. Regroupés ici car ils relèvent du paramétrage de
   * l'école et alimentent ensuite les écritures financières.
   */
  tarifsBibliotheque Json?
  // Apparence
  themeColor        String   @default("blue") @db.VarChar(20)
  sidebarMode       String   @default("light") @db.VarChar(10)
  displayMode       String   @default("light") @db.VarChar(10)
  primaryColor      String   @default("#03a9f3") @db.VarChar(20)
  secondaryColor    String   @default("#16a34a") @db.VarChar(20)
  backgroundColor   String   @default("#2f7d6f") @db.VarChar(20)
  textColor         String   @default("#1f2937") @db.VarChar(20)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ==================== ECOLE PALETTE CONFIG ====================

model EcolePaletteConfig {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  libelle         String   @db.VarChar(100)
  primaryColor    String   @db.VarChar(20)
  secondaryColor  String   @db.VarChar(20)
  backgroundColor String   @db.VarChar(20)
  textColor       String   @db.VarChar(20)
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, actif])
  @@map("ecole_palette_configs")
}

// ==================== WHATSAPP SESSION ====================

model WhatsappSession {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @unique @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionData     Bytes?
  connected       Boolean   @default(false)
  phoneNumber     String?   @db.VarChar(25)
  displayName     String?   @db.VarChar(200)
  connectedAt     DateTime?
  featureOtp      Boolean   @default(false)
  featurePayment  Boolean   @default(false)
  featureAbsence  Boolean   @default(false)
  featureBulletin Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("whatsapp_sessions")
}

// ==================== WHATSAPP OUTBOX ====================

model WhatsappOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone         String    @db.VarChar(30)
  message       String
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, attempts, createdAt])
  @@map("whatsapp_outbox")
}

// ==================== PLATFORM USERS ====================

model PlateformeUtilisateur {
  id             String         @id @default(uuid()) @db.Uuid
  nom            String         @db.VarChar(100)
  prenom         String         @db.VarChar(100)
  email          String         @unique @db.VarChar(254)
  telephone      String?        @db.VarChar(20)
  motDePasse     String
  rolePlateforme RolePlateforme
  actif          Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  auditLogs AuditLog[]
}

// ==================== USERS (flat model - all roles) ====================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  username      String?   @db.VarChar(100)
  email         String?   @db.VarChar(254)
  passwordHash  String
  firstName     String    @db.VarChar(100)
  lastName      String    @db.VarChar(100)
  telephone     String?   @db.VarChar(20)
  numeroIdentificationNational String? @db.VarChar(10)
  adresse       String?
  role          UserRole
  roles         UserRole[] @default([])
  actif         Boolean   @default(true)
  mustChangePwd Boolean   @default(true)

  // ELEVE
  matricule       String?   @db.VarChar(50)
  dateNaissance   DateTime? @db.Date
  lieuNaissance   String?
  genre           Genre?
  numeroUrgence   String?   @db.VarChar(20)
  dateInscription DateTime? @db.Date
  photoUrl        String?
  classeId        String?   @db.Uuid

  cardToken       String?   @unique @db.VarChar(64)
  signatureUrl    String?

  // ENSEIGNANT
  specialite            String?
  dateEmbauche          DateTime? @db.Date
  numeroCNPS            String?   @db.VarChar(50)
  modeCalculNotes       String?   @db.VarChar(20)  // MOYENNE ou MEILLEURE_NOTE
  numeroSecuriteSociale String?   @db.VarChar(50)

  // PARENT
  profession       String?
  lieuTravail      String?
  telephoneTravail String?     @db.VarChar(20)
  lienParente      LienParente?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, matricule], map: "users_tenant_matricule_unique")
  @@index([tenantId, role])

  refreshTokens      RefreshToken[]
  resetTokens        PasswordResetToken[]
  eleveClasse        Classe?              @relation("EleveClasse", fields: [classeId], references: [id])
  elevParents        EleveParent[]        @relation("EleveParents")
  parentEleves       EleveParent[]        @relation("ParentEleves")
  matiereClasses     MatiereClasse[]      @relation("EnseignantMatiereClasses")
  matieresEnseignees ProfesseurMatiere[]  @relation("ProfesseurMatieres")
  presencesEnseignant PresenceCoursProfesseur[] @relation("PresenceCoursProfesseurEnseignant")
  presencesControlees PresenceCoursProfesseur[] @relation("PresenceCoursProfesseurSurveillant")
  paiementsProfesseur  PaiementProfesseur[] @relation("PaiementProfesseurEnseignant")
  paiementsProfesseurCrees PaiementProfesseur[] @relation("PaiementProfesseurCreateur")
  absencesEnseignant AbsenceEnseignant[]
  surveillantCycles  SurveillantCycle[]
  auditLogs          AuditLog[]
  personnelRecord    Personnel?
  classesResponsable Classe[]             @relation("ClasseProfResponsable")
  stagiaireIn        ClasseStagiaire[]    @relation("UserStagiaires")
  pushTokens          PushToken[]
  empruntsOuvrage     EmpruntOuvrage[]   @relation("EmpruntsEmprunteur")
  demandesReductionEleve     DemandeReduction[] @relation("DemandeReductionEleve")
  demandesReductionDemandees DemandeReduction[] @relation("DemandeReductionDemandeur")
  demandesReductionTraitees  DemandeReduction[] @relation("DemandeReductionTraiteur")
  demandesPassageEleve       DemandePassage[]    @relation("DemandePassageEleve")
  demandesPassageCreees      DemandePassage[]    @relation("DemandePassageCreateur")
  demandesPassageTraitees    DemandePassage[]    @relation("DemandePassageTraiteur")
  eleveDocuments             EleveDocument[]     @relation("EleveDocuments")
  demandesAudit              DemandeAudit[]      @relation("demandeAuditDemandeur")
  coursEnseignant            Cours[]             @relation("CoursEnseignant")
}

// ==================== ELEVE DOCUMENTS ====================

model EleveDocument {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eleveId      String       @db.Uuid
  eleve        User         @relation("EleveDocuments", fields: [eleveId], references: [id], onDelete: Cascade)
  type         TypeDocument
  nom          String       @db.VarChar(300)
  fileKey      String       @db.VarChar(1000)
  mimeType     String       @db.VarChar(100)
  taille       Int
  uploadedById String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId, eleveId])
  @@map("eleve_documents")
}

// ==================== ELEVE-PARENT ====================

model EleveParent {
  eleveId  String @db.Uuid
  parentId String @db.Uuid
  eleve    User   @relation("EleveParents", fields: [eleveId], references: [id], onDelete: Cascade)
  parent   User   @relation("ParentEleves", fields: [parentId], references: [id], onDelete: Cascade)

  @@id([eleveId, parentId])
}

// ==================== ACADEMIC STRUCTURE ====================

model Cycle {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  code            String   @db.VarChar(20)
  libelle         String
  typePeriode     String   @default("TRIMESTRE") @db.VarChar(10) // TRIMESTRE | SEMESTRE
  moyenneMaximale Float    @default(20) // 20 pour collège/lycée, 10 pour primaire/préscolaire
  ordre          Int      @default(0)
  seeded          Boolean  @default(false) // true = créé par seed, non modifiable
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  niveaux           Niveau[]
  classes           Classe[] @relation("ClasseCycle")
  surveillantCycles SurveillantCycle[]
  calendriers       CalendrierScolaire[]

  @@unique([tenantId, code])
  @@index([tenantId, ordre])
}

model Niveau {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  cycleId        String   @db.Uuid
  cycle          Cycle    @relation(fields: [cycleId], references: [id])
  code           String   @db.VarChar(20)
  libelle        String
  ordre          Int
  moyennePassage Float    @default(10)
  seeded         Boolean  @default(false) // true = créé par seed, non modifiable
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classes               Classe[]
  personnelAffectations PersonnelNiveauAffectation[]
  matiereNiveaux        MatiereNiveau[]

  @@unique([tenantId, code])
}

model AnneeAcademique {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  libelle     String
  dateDebut   DateTime  @db.Date
  dateFin     DateTime? @db.Date
  estCourante Boolean   @default(false)
  actif       Boolean  @default(true)
  classesDupliquees Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes         Classe[]
  cours           Cours[]
  inscriptions    Inscription[]
  matiereClasses  MatiereClasse[]
  demandesPassage DemandePassage[]
  programmes      ProgrammePedagogique[]

  @@unique([tenantId, libelle])
}

model Batiment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  nom         String
  description String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salles Salle[]
}

model Salle {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  batimentId String   @db.Uuid
  batiment   Batiment @relation(fields: [batimentId], references: [id])
  nom        String
  capacite   Int?
  typeSalle  String?  @db.VarChar(50)
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  classes        Classe[]
  emploisDuTemps EmploiDuTemps[]
}

model Classe {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  nom               String
  cycleId           String?          @db.Uuid
  cycle             Cycle?           @relation("ClasseCycle", fields: [cycleId], references: [id], onDelete: SetNull)
  niveauId          String?          @db.Uuid
  niveau            Niveau?          @relation(fields: [niveauId], references: [id])
  anneeAcademiqueId String?          @db.Uuid
  anneeAcademique   AnneeAcademique? @relation(fields: [anneeAcademiqueId], references: [id])
  salleId           String?          @db.Uuid
  salle             Salle?           @relation(fields: [salleId], references: [id])
  effectifMax       Int?
  actif             Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([tenantId, nom, anneeAcademiqueId])
  @@index([tenantId, cycleId])

  professeurResponsableId String? @db.Uuid
  professeurResponsable   User?   @relation("ClasseProfResponsable", fields: [professeurResponsableId], references: [id])

  eleves          User[]            @relation("EleveClasse")
  matiereClasses  MatiereClasse[]
  cours           Cours[]
  emploisDuTemps  EmploiDuTemps[]
  absences        AbsenceEleve[]
  bulletins       Bulletin[]
  inscriptions    Inscription[]
  appels          Appel[]
  stagiaires      ClasseStagiaire[]
  demandesPassage DemandePassage[]
}

model ClasseStagiaire {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classeId    String   @db.Uuid
  classe      Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)
  stagiaireId String   @db.Uuid
  stagiaire   User     @relation("UserStagiaires", fields: [stagiaireId], references: [id], onDelete: Cascade)
  dateDebut   DateTime @default(now()) @db.Date
  dateFin     DateTime? @db.Date
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("classe_stagiaires")
}

model Matiere {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  code        String   @db.VarChar(20)
  libelle     String
  categorie   String?
  description String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, code])

  matiereClasses  MatiereClasse[]
  matiereNiveaux  MatiereNiveau[]
  cours           Cours[]
  notes           Note[]
  professeurs     ProfesseurMatiere[] @relation("ProfesseurMatieres")
}

model ProfesseurMatiere {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professeurId String   @db.Uuid
  professeur   User     @relation("ProfesseurMatieres", fields: [professeurId], references: [id], onDelete: Cascade)
  matiereId    String   @db.Uuid
  matiere      Matiere  @relation("ProfesseurMatieres", fields: [matiereId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([professeurId, matiereId])
  @@index([tenantId, matiereId])
}

model MatiereClasse {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  matiereId         String          @db.Uuid
  matiere           Matiere         @relation(fields: [matiereId], references: [id])
  classeId          String          @db.Uuid
  classe            Classe          @relation(fields: [classeId], references: [id])
  enseignantId      String          @db.Uuid
  enseignant        User            @relation("EnseignantMatiereClasses", fields: [enseignantId], references: [id])
  anneeAcademiqueId String          @db.Uuid
  anneeAcademique   AnneeAcademique @relation(fields: [anneeAcademiqueId], references: [id])
  anneeScolaire     String          @db.VarChar(10)
